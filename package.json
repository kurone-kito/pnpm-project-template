{
  "name": "@kurone-kito/pnpm-project-template",
  "version": "0.1.0",
  "private": true,
  "description": "The boilerplate project of the Node.js",
  "keywords": [
    "boilerplate",
    "pnpm",
    "template"
  ],
  "homepage": "https://github.com/kurone-kito/pnpm-project-template#readme",
  "bugs": "https://github.com/kurone-kito/pnpm-project-template/issues",
  "repository": "github:kurone-kito/pnpm-project-template",
  "license": "MIT",
  "author": "kurone-kito <krone@kit.black> (https://kit.black/)",
  "type": "module",
  "files": [],
  "scripts": {
    "clean": "rimraf -g \"*.tgz\" \"*.tsbuildinfo\" node_modules/.cache",
    "lint": "pnpm run --stream \"/lint:check:.+/\"",
    "lint:check:biome": "biome check",
    "lint:check:cspell": "cspell lint --show-suggestions .",
    "lint:check:markdown": "markdownlint-cli2 \"**/*.md\"",
    "lint:fix": "pnpm run --stream \"/(lint:fix:.+|lint:check:cspell)/\"",
    "lint:fix:biome": "biome check --write",
    "lint:fix:markdown": "markdownlint-cli2 --fix \"**/*.md\"",
    "prepare": "husky",
    "test": "pnpm run lint"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@cspell/cspell-types": "^10.0.1",
    "@kurone-kito/biome-config": "^0.23.0",
    "@kurone-kito/commitlint-config": "^0.23.0",
    "@kurone-kito/cspell-config": "^0.23.0",
    "@kurone-kito/lint-staged-config": "^0.23.0",
    "@kurone-kito/markdownlint-config": "^0.23.0",
    "@kurone-kito/typescript-config": "^0.22.0-alpha.9",
    "cspell": "^10.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "markdownlint-cli2": "^0.23.2",
    "rimraf": "^6.1.3",
    "typescript": "~7.0.2"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "engines": {
    "node": "^22.23.2 || ^24.2.0 || >=26.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
